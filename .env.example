# Generate a value using the command in README.md. Do not commit real secrets.
STAFF_ACCESS_CODE_HASH=
# A long random string used to sign the staff session cookie.
STAFF_SESSION_SECRET=
# Production on Vercel: generated when you connect a private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Optional local development override. Without a Blob token, the app uses this JSON file.
# ATTENDANCE_DATA_DIR=/var/data
